//Write and 8-bit value 'v' to address 'addr'
void writeMem(int addr, int v)
{
    addr &= ADDR_MASK;
    v &= DATA_MASK;
	ivec2 aLoc = map_region(addr, MEM_BASE, MEM_SIZE);
    if(uv == aLoc)
    {
    	frag.x = float(v);   
    }
}

//Read 8-bit value from memory
//Checks if an address is cached.
//If so, returns cached result
//If not, reads from the memory buffer
int readMem8(int addr)
{
    addr &= ADDR_MASK;
    
    ivec4 cr = ivec4(texelFetch(iChannel0, CACHE_BASE+ivec2(hash(addr),0),0));
    bvec2 cmp = equal(cr.xz, ivec2(addr+1));
    int result = int(texelFetch(iChannel1, map_region(addr, MEM_BASE, MEM_SIZE), 0).x);;
    
    if(any(cmp))
    {
    	result = cmp.x ? cr.y : cr.w;
    }
    
    return result;
}

int keyCodeToAscii(int keycode, bool shift, bool altgr)
{
    //The keyboard texture doesn't provide ascii values or handle shift keys
    //This array only contains the keys to be remapped, if a key isn't present, they keycode is used.
    //X = keycode
    //Y = ASCII
    //Z = ASCII w/ Shift
    //W = ASCII w/ AltGr
	ivec4[] keyCodeMap = ivec4[](
        #if(KBD_LAYOUT == 0) //QWERTY
        ivec4(0x08,0xDF,0xDF,0x00),ivec4(0x30,0x30,0x29,0x00),ivec4(0x31,0x31,0x21,0x00),ivec4(0x32,0x32,0x40,0x00),
        ivec4(0x33,0x33,0x23,0x00),ivec4(0x34,0x34,0x24,0x00),ivec4(0x35,0x35,0x25,0x00),ivec4(0x36,0x36,0x5E,0x00),
        ivec4(0x37,0x37,0x26,0x00),ivec4(0x38,0x38,0x2A,0x00),ivec4(0x39,0x39,0x28,0x00),ivec4(0xBA,0x3B,0xBA,0x00),
        ivec4(0xBB,0x3D,0x2B,0x00),ivec4(0xBC,0x2C,0xBC,0x00),ivec4(0xBD,0x2D,0x5F,0x00),ivec4(0xBE,0x2E,0xBE,0x00),
        ivec4(0xBF,0x2F,0xBF,0x00),ivec4(0xC0,0x60,0x7E,0x00),ivec4(0xDB,0xDB,0x7B,0x00),ivec4(0xDC,0xDC,0x7C,0x00),
        ivec4(0xDD,0xDD,0x7D,0x00),ivec4(0xDE,0x27,0x22,0x00)
        #endif
        #if(KBD_LAYOUT == 1) //AZERTY (Thanks to FabriceNeyret2)
        ivec4(0x08,0xDF,0xDF,0x00),ivec4(0x30,0x40,0x30,0x40),ivec4(0x31,0x26,0x31,0x00),ivec4(0x32,0x7E,0x32,0x00),
        ivec4(0x33,0x22,0x33,0x00),ivec4(0x34,0x27,0x34,0x00),ivec4(0x35,0x28,0x35,0x00),ivec4(0x36,0x2D,0x36,0x00),
        ivec4(0x37,0x60,0x37,0x00),ivec4(0x38,0x5F,0x38,0x00),ivec4(0x39,0x5E,0x39,0x00),ivec4(0x3A,0x40,0x3A,0x00),
        ivec4(0xBA,0x24,0x00,0x00),ivec4(0xBB,0x3D,0x2B,0x00),ivec4(0xBC,0x2C,0x3F,0x00),ivec4(0xBD,0x2D,0x5F,0x00),
        ivec4(0xBE,0x3B,0x2E,0x00),ivec4(0xBF,0x3A,0x2F,0x00),ivec4(0xC0,0x5B,0x25,0x00),ivec4(0xDB,0x29,0x5D,0x00),
        ivec4(0xDC,0x3C,0x3E,0x00),ivec4(0xDD,0x29,0x5D,0x00),ivec4(0xDE,0x27,0x22,0x00),ivec4(0xDF,0x21,0xDF,0x00)     
        #endif
	);
    
    int ascii = keycode;
    
    for(int i = 0;i < keyCodeMap.length();i++)
    {
        ivec4 map = keyCodeMap[i];
        if(map.x == keycode)
        {
        	ascii = shift ? map.z:
            		altgr ? map.w:
            			    map.y;
        }
    }
    
    return ascii;
}

//Scans the keyboard and outputs the first pressed key it finds.
int scanKeyboard()
{
    bool shift = (texelFetch(iChannel2,ivec2(16,0),0).x != 0.0);
    bool altgr = (texelFetch(iChannel2,ivec2(18,0),0).x != 0.0);
    
    for(int i = 0;i < 256;i++)
    {
        float keypressed = texelFetch(iChannel2,ivec2(i,1),0).x;
        
        if(keypressed != 0.0 && i != 16 && i != 18)
        {            
        	return keyCodeToAscii(i, shift, altgr) | 0x80; //Apple 1 software expects bit 7 to be set.
        }
    }
    
    return 0x00;
}

//Reads characters from the display buffer & handles cursor positioning/scrolling.
void updateTerminal()
{
    cursor = ivec2(texelFetch(iChannel1, CURSOR_BASE, 0).zw); //Read the cursor from the previous frame.

    int char = 0;
    
    //Loop through the display buffer and write them to the display.
    for(int i = 0;i < DSPBUF_SIZE;i++)
    {
        char = int(texelFetch(iChannel0, DSPBUF_BASE+ivec2(i,0), 0).x);
        
        if(char != 0x00) //Assume 0x00 = no character
        {
            //Go to next line if CR is printed or if the cursor is off the edge of the screen.
            if(char == 0x0D || cursor.x >= TERM_SIZE.x)
            {
                cursor.x = 0;
                cursor.y++;

                //Once the cursor reaches the bottom of the screen, all further lines will scroll it up.
                if(cursor.y >= TERM_SIZE.y-1)
                {
                    //Clear next line to scroll
                    if(uv.x >= 0 && uv.y == (cursor.y % TERM_SIZE.y))
                    {
                        frag.y = 0.0;
                    }
                }
            }

            //Don't print control charaters.
            if(char >= 0x20)
            {
                //Save the character at the cursor pos and move the cursor.
                if(uv == cursor % TERM_SIZE)
                {
                    frag.y = float(char);
                }
                cursor.x++;
            }

            //Clear DSP after writing to the screen.
            //Bit 7 clear indicates the terminal is ready.
            writeMem(DSP, 0x00);
        }
    }
    
    //Save cursor position.
    if(uv == CURSOR_BASE)
    {
    	frag.zw = vec2(cursor);
    }
}

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
    uv = ivec2(fragCoord);
    frag = texelFetch(iChannel1, uv, 0);
    
    if(IN_RECT(uv, MEM_BASE, MEM_SIZE))
    {
        //Write cache from CPU buffer back to memory
        int addr = unmap_region(uv, MEM_BASE, MEM_SIZE);
        ivec4 cr = ivec4(texelFetch(iChannel0, CACHE_BASE+ivec2(hash(addr),0),0));
        if(cr.x != 0){writeMem(cr.x-1, cr.y);}
        if(cr.z != 0){writeMem(cr.z-1, cr.w);}
		
        //Initialize memory on frame 0
        if(iFrame == 0)
        {
            int addr = unmap_region(uv, MEM_BASE, MEM_SIZE);

            writeMem(addr, rom(addr));
        }
        
        //Current key pressed.
        if(addr == KBD)
        {
            int key = scanKeyboard();
			if(key != 0)
            {
            	writeMem(KBD, key);
            }
        }
        
        //Set bit 7 of KBDCR to 1 to indicate a ket press is available.
        if(addr == KBDCR)
        {
            int key = scanKeyboard();
            if(key != 0)
            {
            	writeMem(KBDCR, 0x80);
            }
        }
        
        updateTerminal();
    }
    fragColor = frag;
}