#define bitmask(a)  ((1<<a)-1)
float bituni(int a,int b) { return  ( float(a)*(1.0/float(bitmask(b))) ); }

vec3 dec(int h,int a,int b,int c)
{
    vec3 v=vec3( bituni((h>>(b+c)) & bitmask(a),a) ,
                 bituni((h>>(c)) & bitmask(b),b) ,
                 bituni(h & bitmask(c),c)  ) ;
    return v;
}


