    https://www.fractalforums.com/fragmentarium/solids-many-many-solids/30/
        
    Wythoff Mathematical Details - Greg Egan
    http://www.gregegan.net/APPLETS/26/WythoffNotes.html
        
    heavy metal squiggle orb - mattz
    https://www.shadertoy.com/view/wsGfD3

    IQ Distance functions
    https://iquilezles.org/articles/distfunctions

    Wythoff Polyhedra with Exact SDF - mla
    https://www.shadertoy.com/view/WlccR8

    The so-called "folding" technique consists in using a succession of reflections 
    to end up with a reduced domain of coordinates 
       
    The **spherical** triangle used to fold the coordinates is (P, Q, R) with **fractions of PI** PI/2, PI/3 , PI/5 for angles. 
    Even if the drawing below is FLAT, it represents a triangle on a SPHERE.
    
      Q=3 *--__
          |    ^^--__
      R=2 *----------* P = 5
    
    The sum of these angles is more than PI (180°), this is because we are tiling a sphere here.
    
    The shape generated by the distance field using the z direction 
    is a Rhombic Triacontahedron made of 30 rhombic faces formed by 4 coplanar triangles.

    Icosahedron and Dodecahedrons : you get it by rotation of the plan of this triangle around the X or Y axis.
    R is the middle of an edge of the Ico or Dode
    Q is the vertex of a Dode, middle of the face of an Ico
    P is the vertex of an Ico, middle of the face of a Dode
    
*/

// folding function - here only 3 fold loops 
// https://www.shadertoy.com/view/ltlGWM
// https://en.wikipedia.org/wiki/Polyhedral_group
vec3 opIcosahedralSymmetry( vec3 p )
{    
    // const float c = cos(PI/5.), s=sqrt(0.75-c*c);
    // cos(PI/5.) = 0.80901699437
    // const vec3 n = vec3(-0.5, -c, s);
    const vec2 gr = cos(3.14159/vec2(3,5)); // a golden rectangle !
    const vec3 n = vec3(-gr, sqrt(1.-dot(gr,gr))); 
    p = abs(p);
    for (int i=0;i<3;i++) {
        float side = dot(p, n);
        if ( side > 0.0 ) break;
        p -= 2.*min(0., side)*n;
        if (i!=2) p.xy = abs(p.xy);
    }
    return p;
}    

// some rounded Ico & Dode

float Ico(vec3 p) {
    vec3 q = vec3(p.x - X_TO_ICO_VERTEX,-p.y,p.z-1.0); // position origin at the vertex
    q.zy *= Rot(ICODIHEDRAL*.5); 
    // min added for interior distance
    return length(max(q, 0.))+min(q.z, 0.);  // z can be used for interior distance
}

float Dode(vec3 p) {
    vec3 q = vec3(-p.x,p.y - Y_TO_DODE_VERTEX,p.z-1.0); // position origin at the vertex
    q.zx *= Rot(DODEDIHEDRAL*.5); 
    return length(max(q, 0.))+min(q.z, 0.); 
}

// I played with these functions

float GetDistDodecahedron(vec3 p) {
    vec3 q = p - ICOMIDEDGE;      // move
    q.xz *= Rot(DODEDIHEDRAL*.5); // rotate
    // rounded edge
    vec3 vtx = vec3(-q.x,q.y - Y_TO_DODE_VERTEX,q.z);
    // onioning and rounding
    float dDode = abs(length(max(vtx, 0.))+min(vtx.z, 0.)-.025)-.05; 
    // Holes are centered on the dodecaheron's faces center
    vec2 pCenter = vec2(q.x - X_TO_DODE_CENTER,q.y);
    float dHole = length( pCenter ) - .3;    
    // Smaller circles are centered somewhere between the middle of the face and the vertex of the Ico
    float dSmallHole = abs(abs(length( q.xy-mix(vec2(0.0,Y_TO_DODE_VERTEX),vec2(X_TO_DODE_CENTER,0.0),.3) ) - .07)-.030)-.015;
    // Spheres on the vertices (dodecahedron's vectrices are icosahedron face's centers)
    float dCorners = length(p - ICOMIDFACE * 1.24)-.12;    
    // blobby cross picked from IQ's magic box
    float dBlobbyCross = sdBlobbyCross(vec2(q.x-X_TO_DODE_CENTER*.2,q.y)*13.0,0.80)/13.0-.03;
    // combine
    float dist = dDode;
    float dCarvings = min(dHole,min(dSmallHole,dBlobbyCross));
    dist = smax(dist,-(dHole+.1),.04);
    dist += 0.008*smoothstep(0.01,-0.01,dCarvings);
    dist = smin(dist,dCorners,.07);
    return dist;
}

float GetDistIcosahedron(vec3 p) {
    vec3 q = p - ICOMIDEDGE;     // move
    q.yz *= Rot(ICODIHEDRAL*.5); // rotates the coordinates to have XY plan aligned with a ICO face's plan
    // rounded edge
    vec3 vtx = vec3(q.x - X_TO_ICO_VERTEX,-q.y,q.z);
    float dIco = length(max(vtx, 0.))+min(vtx.z, 0.)-.10;
    // Circles are centered on the icosahedron's faces
    float dBigHole = abs(abs(abs(length(q.xy - vec2(0.0,Y_TO_ICO_CENTER))-.17)-.08)-.04)-.02;
    // Smaller circles are centered somewhere between the middle of the face and the vertex of the Ico
    float dSmallHole = abs(abs(length( q.xy - mix(vec2(0.0,Y_TO_ICO_CENTER),vec2(X_TO_ICO_VERTEX,0.0),.60) ) - .07)-.025)-.010;
    // little chains of spheres on the edges
    float dBalls = length(q-vec3(round(q.x*20.0)/20.0,0.0,0.1))-.03;
    // Corners of the Ico
    q = p - ICOVERTEX * 1.3;      // move
    q.xz *= Rot(DODEDIHEDRAL*.5); // rotate
    float dCorners = length(q)-.04*(1.0+.5*sin(q.z*50.0));    
    // combine
    float dist = dIco;
    float dCarvings = min(dBigHole,dSmallHole);
    dist += 0.008*smoothstep(0.01,-0.01,dCarvings);
    dist = smin(dist,dCorners-.13,.1);
    dist = min(dist,dBalls);
    return dist;
}

// Not sure it is but looks like
float GetDistSmallStellatedDodecahedron(vec3 p) {
    vec3 q = p;
    q -= ICOMIDEDGE;
    float an = DODEDIHEDRAL*.5; // angle of a face with the rhombic face
    q.zx *= Rot(an);
    vec2 vtx = q.xy;
    float h = cos(DODEDIHEDRAL*.5)*X_TO_ICO_VERTEX; 
    h /= cos(an+DODEDIHEDRAL*.5); // Need to calculate again the intersection point with the folding plan
    vtx.x -= h;
    vec2 edge = normalize(vec2(h,-Y_TO_DODE_VERTEX));
    mat2 r = mat2(edge.x,edge.y,-edge.y,edge.x);
    vtx.xy *= r; // align xy coordinates to the edge
    float dStella = length(max(vec3(vtx,q.z), 0.)) + min(max(vtx.x,max(vtx.y,q.z)),0.);  // z can be used for interior distance
    float lines = clamp(q.x-h*.55,0.0,0.48);
    dStella -= 0.01*smoothstep(-0.3,0.9,sin(lines*3.14*20.));
    float dHorseShoe = sdHorseshoe(q.yx-vec2(0.0,0.4),vec2(sin(0.45),cos(0.45)),.14,vec2(.04));
    dStella -= .1; // rounding
    dStella = smax(dStella,-dHorseShoe,.02);
    // get a smooth non-convex dihedral angle is a challenge
    // here I build a base using 2 intersecting planes and smoothed angle
    float dBase = smax(p.z-1.13,dot(p,ICOMIDFACE)-1.19,0.005);
    return smin(dStella,dBase,.01 );
}

// Not sure it is but looks like
float GreatDodecahedron(vec3 p) {
    vec3 q = p;
    q -= ICOMIDEDGE;
    float an = -ICODIHEDRAL;
    q.zy *= Rot(an);
    vec3 vtx = vec3(q.x - X_TO_ICO_VERTEX,-q.y,q.z);
    float dDode = length(max(vtx, 0.0)) + min(vtx.z, 0.0);
    float dist = dDode -.05 + 0.008*smoothstep(0.01,-0.01,sdRoundedX(q.xy-vec2(0,0.15),.1,.02));
    return dist;
}

// Not sure it is but looks like
float GreatStellatedDodecahedron(vec3 p) {
    vec3 q = p;
    q -= ICOMIDEDGE; 
    float an = PI*.5-DODEDIHEDRAL*.5; // angle of a face with the rhombic face
    q.zy *= Rot(an);
    // tip of the polyhedron, point of intersection with folding plan
    // TODO : Will make it more understandable using a 2D plan in desmos
    // https://www.desmos.com/calculator/abjapu0oqi
    float h = cos(ICODIHEDRAL*.5)*Y_TO_DODE_VERTEX/cos(an+ICODIHEDRAL*.5); 
    vec2 vtx = vec2(-q.x,q.y-h); // changing coordinates 
    vec2 edge = normalize(vec2(X_TO_ICO_VERTEX,h));
    vtx.xy *= orient(edge); // align x coordinate to the edge vector
    float dStella = length(max(vec3(vtx,q.z), 0.)) + min(q.z,0.);  // z can be used for interior distance
    float lines = clamp(q.y-h*.45,0.0,0.48);
    dStella -= 0.01*smoothstep(-0.3,0.9,sin(lines*3.14*20.));
    // get a smooth non-convex dihedral angle is a challenge
    // here I build a base using smoothed intersecting planes
    float dBase = smax(p.z-1.25,dot(p,ICOVERTEX)-1.35,0.04);
    float dist = smin(dStella- .1,dBase,0.02);
    return dist;
}

// An experiment using some torus crossing at the intersect of the folding plans
float TorusFlower(vec3 q) {
    float r2 = .025;
    float d = 1e10;
    
    {
        float an = PI/3.;   // here you can change the width of the Vesicas
        float r = 1.0;
        vec3 n = vec3(1.,0.,0.);
        n.zx *= Rot(an);   // XZ symetry plane, rotated of an angle around the Y axis
        float dO = dot(ICOMIDFACE,n),         // calculate the distance between the plan and point ICOMIDFACE on the sphere
        rCircle = sqrt(1.-dO*dO);             // radius of the circle at intersection of plan and sphere
        d = distTorus(q-dO*n*r,rCircle*r,r2,n);   // draws the torus based this calculation
    }
    {
        float an = (PI/5.+PI/2.)/2.;   // I found impossible to have a value to make it tangent to both triangle edges
        float r = 0.95;
        vec3 n = erot(P35,normalize(ICOVERTEX-ICOMIDFACE),an); // P35 symetry plan, rotated of an angle around the hypotenuse axis
        float dO = dot(ICOMIDFACE,n),
        rCircle = sqrt(1.-dO*dO);
        d = min(d,distTorus(q-dO*n*r,rCircle*r,r2,n));
    }
    {
        float an = PI/5.;  
        float r = 1.05;
        vec3 n = vec3(0.,1.,0.);
        n.zy *= Rot(an);  
        float dO = dot(ICOVERTEX,n),         
        rCircle = sqrt(1.-dO*dO);            
        d = min(d,distTorus(q-dO*n*r,rCircle*r,r2,n));   
    }
    return d;
}

float sdCone( vec3 p, vec2 c )
{
    // c is the sin/cos of the angle
    vec2 q = vec2( length(p.xz), -p.y );
    float d = length(q-c*max(dot(q,c), 0.0));
    return d * ((q.x*c.y-q.y*c.x<0.0)?-1.0:1.0);
}

