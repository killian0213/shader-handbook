// Work in progress
float ChineseBall(vec3 p) {
    vec3 q = p;
    float dDode = length(p)-1.0;
    dDode = abs(dDode-.025)-.05; // onioning and rounding
    // Holes are centered on the dodecaheron's faces center
    q.xz *= Rot(DODEDIHEDRAL*.5); // rotates the coordinates to have XY plan aligned with a DODE face plan
    vec2 pCenter = vec2(q.x - X_TO_DODE_CENTER,q.y);
    pCenter = q.xy;
    float dHole = length( pCenter ) - .55;    
    // shaking mixing the distances
    float dist = dDode;
    dist = smax(dist,-(dHole+.1),.04);
    return dist;
}

// IQ & filbs111
float sdOctahedron(vec3 p, float s)
{
    p = abs(p);
    float m = p.x + p.y + p.z - s;
    vec3 r = 3.0*p - m;
    vec3 o = min(r, 0.0);
    o = max(r*2.0 - o*3.0 + (o.x+o.y+o.z), 0.0);
    return length(p - s*o/(o.x+o.y+o.z));
}
// flockaroo - https://www.shadertoy.com/view/dlcGRH
float GetDistFoldedOctahedron(vec3 p) {
    float dist = sdOctahedron(p,1.5)-.04;
    return dist;
}



const float nShapes = 8.;
float shapeID = 0.0;
float GetDist(vec3 p) {
    vec3 q = opIcosahedralSymmetry(p);
//     Change shape ID here
// shapeID=6.5;
    float d = 1e10;
    if ( shapeID < 0.5 )
        d = GetDistDodecahedron(q);
    else if ( shapeID < 1.5 )
        d = GetDistIcosahedron(q);
    else if ( shapeID < 2.5 )
        { d = GetDistSmallStellatedDodecahedron(q/0.8)*0.8; }
    else if ( shapeID < 3.5 )
        { d = GreatDodecahedron(q/1.2)*1.2; }
    else if ( shapeID < 4.5 )
        { d = GreatStellatedDodecahedron(q*1.7)/1.7; }
    else if ( shapeID < 5.5 )
        { d = TorusFlower(q/1.22)*1.22; } 
    else if ( shapeID < 6.5 )
        { d = ChineseBall(q); }
    else if ( shapeID < 7.5 )
        { d = GetDistFoldedOctahedron(q); }
     float d2=min(q.x,min(q.y,dot(q,P35)))-.01;
     d2 = max(d2,q.z-1.);
   //  d = min(d,d2); // show folded space

    return d;
    
}

float RayMarch(vec3 ro, vec3 rd) {
	float dO=0.;
    for(int i=0; i<MAX_STEPS; i++) {
    	vec3 p = ro + rd*dO;
        float dS = GetDist(p);
        dO += dS;
        if(dO>MAX_DIST || abs(dS)<SURF_DIST) break;
    }
    return dO;
}

vec3 GetNormal(vec3 p) {
	float d = GetDist(p);
    vec2 e = vec2(.001, 0);
    vec3 n = d - vec3(
        GetDist(p-e.xyy),
        GetDist(p-e.yxy),
        GetDist(p-e.yyx));
    return normalize(n);
}

vec3 GetRayDir(vec2 uv, vec3 p, vec3 l, float z) {
    vec3 f = normalize(l-p),
        r = normalize(cross(vec3(0,1,0), f)),
        u = cross(f,r),
        c = f*z,
        i = c + uv.x*r + uv.y*u,
        d = normalize(i);
    return d;
}

float calcSoftshadow( in vec3 ro, in vec3 rd, in float mint, in float tmax )
{
    float res = 1.0;
    float t = mint;
    for( int i=0; i<24; i++ )
    {
		float h = GetDist( ro + rd*t );
        float s = clamp(8.0*h/t,0.0,1.0);
        res = min( res, s*s*(3.0-2.0*s) );
        t += clamp( h, 0.02, 0.2 );
        if( res<0.004 || t>tmax ) break;
    }
    return clamp( res, 0.0, 1.0 );
}

float calcOcclusion( in vec3 pos, in vec3 nor )
{
	float occ = 0.0;
    float sca = 1.0;
    for( int i=0; i<5; i++ )
    {
        float h = 0.01 + 0.33*float(i)/4.0;
        vec3 opos = pos + h*nor;
        float d = GetDist( opos );
        occ += (h-d)*sca;
        sca *= 0.95;
    }
    return clamp( 1.0 - 2.0*occ, 0.0, 1.0 );
}


void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
    vec3 orange = vec3(1.00,.25,0.01);
    vec3 sun   = vec3(1.64,1.27,0.99);
    vec2 uv = (fragCoord-.5*iResolution.xy)/iResolution.y;
	vec2 m = (2.0*iMouse.xy-iResolution.xy)/iResolution.y;
    vec3 ro = vec3(0, 0, -2.8);
    shapeID = floor(fract(T/nShapes)*nShapes);
    if( iMouse.z>0.001 )
    {
        ro.yz *= Rot(-m.y*3.14);
        ro.xz *= Rot(-m.x*6.2831);
    } else {   
        ro.zx *= Rot(T*4.0);
        ro.xy *= Rot(T*2.);
    }
    vec3 rd = GetRayDir(uv, ro, vec3(0,0.,0), 1.0);
    vec3 bg = orange*cos(length(uv));
    vec3 col = bg;
   
    float d = RayMarch(ro, rd);

    if(d<MAX_DIST) {
        vec3 p = ro + rd * d;
        vec3 nor = texBump(iChannel0,p*.5,GetNormal(p),.005);
        float occ = max(.1,calcOcclusion(p,nor));
        vec3  lig1 = normalize( vec3( 0.10, 1.50, 0.40) );
        vec3  lig2 = normalize( vec3(-1.50,-1.00, -1.00) );
        vec3  lig3 = normalize( vec3( 1.50,-1.00, -1.00) );
        // IQ's Blinn-Phong specular formula
        float lig1_spe = pow(clamp(dot(nor,normalize( lig1-rd )),0.0,1.0),8.0) * max(0.0,dot(nor,lig1));
        float lig2_spe = pow(clamp(dot(nor,normalize( lig2-rd )),0.0,1.0),8.0) * max(0.0,dot(nor,lig2));
        float lig3_spe = pow(clamp(dot(nor,normalize( lig3-rd )),0.0,1.0),8.0) * max(0.0,dot(nor,lig3));
        float sha1 = calcSoftshadow( p+0.01*nor, lig1, 0.01, 2.1 );
        col = vec3(0);
        col += 0.6 * lig1_spe * sun * sha1;
        col += 0.2 * lig2_spe * orange * occ;
        col += 0.2 * lig3_spe * orange * occ;        
    } 
    
    // https://graphtoy.com/?f1(x,t)=floor(fract(x/10)*10)&v1=true&f2(x,t)=pow(.5+.5*cos(x*6.28),32)&v2=true&f3(x,t)=&v3=false&f4(x,t)=&v4=false&f5(x,t)=&v5=false&f6(x,t)=&v6=false&grid=1&coords=1.645933014354067,2.5645933014354068,12
    col = mix(col,bg,pow(.5+.5*cos((2.*PI*fract(T))),32.));
    col = pow(col, vec3(.4545));	// gamma correction
    
    fragColor = vec4(col,1.0);
}
