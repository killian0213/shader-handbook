    // CNN Step 7: Softmax + prediction
    // 1x26 => 1 character
    else if (F.x <= int(num_classes)  && F.y == 1) {
        vec3 res = vec3(0); // r: prediction index, g: prediction confidence, b: sum of confidences
        
        // Calculate sum of confidences for Softmax
        // and the prediction with highest confidence
        for (float i = 0.; i < num_classes; i++) {
            float val = texelFetch(iChannel1, ivec2(int(i), 0), 0).r;
            res.b += val;
            if (val > res.g) {
                res.xy = vec2(i, val);
            }
        }
        
        // Store result of Softmax function for each output
        if (F.x < int(num_classes))
            col.r = texelFetch(iChannel1, ivec2(F.x, 0), 0).r / res.b; 
        // Store highest confidence prediction
        else 
            col.rg = vec2(res.r, res.g / res.b);
    }
    
    fragColor = vec4(col, 1);
