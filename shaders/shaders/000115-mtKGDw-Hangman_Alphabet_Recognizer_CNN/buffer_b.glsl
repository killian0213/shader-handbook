// Draw area margin
const float margin = .15;

// Get normalized input pixel
// p: [0, input_res-1]
float i(vec2 p) {  
    p = vec2((p.x+.5) / iAspect, p.y+.5) / input_res;
    
    p *= (1. - margin);
    p.x += margin*.5/iAspect + iR;
    p.y += margin;    
    
    return textureLod(iChannel0, p, log2(iResolution.y/input_res)).r;
}

