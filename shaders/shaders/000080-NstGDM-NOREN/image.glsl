#define ZERO min(iFrame,0)

// network
void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    // 384 bytes used as temporary memory
    float a[32]; // max = layer 2
    float b[64]; // max = layer 1
    
    
    // --- layer 0 (2) : input ---------------
    a[0] = fragCoord.x/iResolution.x;
    a[1] = fragCoord.y/iResolution.y;

    // --- layer 1 (64) -----------------------
    for( int i=ZERO; i<kN1; i++ )
    {
        float f = kL1[(kN0+1)*i+kN0];
        for( int j=0; j<kN0; j++ )
            f += kL1[(kN0+1)*i+j]*a[j];
        b[i] = fun( f );
    }
    
    // --- layer 2 (32) -----------------------
    for( int i=ZERO; i<kN2; i++ )
    {
        float f = kL2[(kN1+1)*i+kN1];
        for( int j=0; j<kN1; j++ )
            f += kL2[(kN1+1)*i+j]*b[j] ;
        a[i] = fun( f );
    }
    
    // --- layer 3 (16) -----------------------
    for( int i=ZERO; i<kN3; i++ )
    {
        float f = kL3[(kN2+1)*i+kN2];
        for( int j=0; j<kN2; j++ )
            f += kL3[(kN2+1)*i+j]*a[j];
        b[i] = fun( f );
    }

    // --- layer 4 (8) -----------------------
    for( int i=ZERO; i<kN4; i++ )
    {
        float f = kL4[(kN3+1)*i+kN3];
        for( int j=0; j<kN3; j++ )
            f += kL4[(kN3+1)*i+j]*b[j] ;
        a[i] = fun( f );
    }

    // --- layer 5 (1) : output --------------
    for( int i=ZERO; i<kN5; i++ )
    {
        float f = kL5[(kN4+1)*i+kN4];
        for( int j=0; j<kN4; j++ )
            f += kL5[(kN4+1)*i+j]*a[j];
        b[i] = f;
    }

    fragColor = vec4(b[0], b[0], b[0], 1.0);
}