//----------------------------------------
// Amplifier
//  vec3 p( drive, pressure, volume)
vec2 amp(vec2 i,vec3 p){return clamp(sign(i)*pow(abs(i*p.x)*.01,vec2(1./p.y))*100.,-1.,1.)*p.z;}

//----------------------------------------
// Panpot
float stereo=.5;
vec2 panpot(int n){
    float p=float(n-8);
    float p1=.8-(abs(p)*.2)*stereo,p2=.8+(abs(p)*.06)*stereo;
    return p<0.?vec2(p1,p2):vec2(p2,p1);
}

//----------------------------------------
// Envelope
float env1(float r,float t){float v=max(1.-t*r,0.);return v>0.?v*v:0.;}
float env2(float r,float t){float v=max(1.-t*r,.75-t*r*.125);return v>0.?v*v:0.;}
float env3(float r,float t){float v=max(1.-t*r,.5);return v>0.?v*v:0.;}
float env4(float r,float t){float v=max(min(1.-t*r,6.-t*r*3.),.0);return v>0.?v*v:0.;}

//----------------------------------------
// SCC Oscillator
const float i128=1./128.;
float scc(float x,int i){
    int pos=int(mod(x*32.,32.));
    return float((((wt[(i<<3)+(pos>>2)]>>(24-((pos&3)<<3)))&255)^128)-128)*i128;
}

//----------------------------------------
// Percussion Oscillator
float sd(float f,float t){
    float o=scc(290.*t,6)*scc(270.*t,7)*env2(20.,t);
    o+=clamp(sin((f-t*f*.3)*t+scc(t*42.,6)*.4)*3.,-1.,1.)*env1(6.,t);
    return o;
}
float bd(float f,float t){
    return clamp(sin((f-t*f*3.)*t+scc(t*160.,6)*.4)*5.,-1.,1.)*env1(11.,t);
}
float hh(float f,float t){return scc(f*t,6)*scc((f*.969)*t,7)*env1(20.,t);}
float cl(float f,float t){return clamp(scc(f*t*.31,6)*scc(f*t*.1,7)*5.,-1.,1.)*env1(7.,t);}
float cb(float f,float t){return (scc(f*t*.75,4)+scc(f*t,4)+scc(f*.29*t,6)*.3)*env1(10.,t)*.5;}
float co(float f,float t){return scc(f*t,3)*scc(f*t*.61,5)*env1(12.,t);}

//----------------------------------------
// Frequency From MIDI Note Number
const float i12=1./12.;
float freq(float n){return pow(2.,(n-69.)*i12)*base;}

//----------------------------------------
// Sequencer
int bar;
int tick;
float tt;
float tl;
const float i6=1./6.;
const float i15=1./15.;
vec2 getNote(int sq){
    vec2 o=vec2(0);
    int n=(np[(sq>>16)&255]>>(28-(tick<<2)))&15;
    if(n==0)return o;
    int k=(sq>>24)&255,p=pp[sq&255],g=(gp[(sq>>8)&255]>>(28-(tick<<2)))&15;
    int m=(p>>30)&1,i=(p>>28)&7,e=(p>>24)&7,s=(p>>16)&15;
    float v=float((p>>20)&15)*i15,t=tt+tl*float(g);
    if((e&2)==0){v*=(e&1)==0?env1(2.5,t):env2(2.5,t);}
            else{v*=(e&1)==0?env3(2.0,t):env4(3.5,t);}
    float f=freq(float(k+n-1)+float((p>>27)&1)*.05);
    o+=panpot(s)*scc(f*t,i)*v;
    return o;
}
vec2 getDrum(int sq){
    vec2 o=vec2(0);
    int h=(rp[(sq>>24)&255]>>(28-(tick<<2)))&15;
    int c=(rp[(sq>>16)&255]>>(28-(tick<<2)))&15;
    int b=(rp[(sq>>8)&255]>>(28-(tick<<2)))&15;
    int s=(rp[sq&255]>>(28-(tick<<2)))&15;
    o+=h<15?panpot(7)*hh(440.,tt+tl*float(h))*.4:vec2(0);
    o+=c<15?panpot(7)*cl(440.,tt+tl*float(c))*.6:vec2(0);
    o+=b<15?panpot(8)*bd(480.,tt+tl*float(b))*.6:vec2(0);
    o+=s<15?panpot(10)*sd(903.,tt+tl*float(s))*.6:vec2(0);
    return o;
}
vec2 getPerc(int sq){
    vec2 o=vec2(0);
    int c=(rp[(sq>>24)&255]>>(28-(tick<<2)))&15;
    int b=(rp[(sq>>16)&255]>>(28-(tick<<2)))&15;
    int l=(rp[(sq>>8)&255]>>(28-(tick<<2)))&15;
    int m=(rp[sq&255]>>(28-(tick<<2)))&15;
    o+=c<15?panpot(7)*cb(840.,tt+tl*float(c))*.5:vec2(0);
    o+=b<15?panpot(7)*cb(440.,tt+tl*float(b))*.5:vec2(0);
    o+=l<15?panpot(8)*co(904.,tt+tl*float(l))*.3:vec2(0);
    o+=m<15?panpot(10)*co(1400.,tt+tl*float(m))*.3:vec2(0);
    return o;
}
vec2 sequencer(float time){
    vec2 o=vec2(0);
    if(time<0.)return o;
    tl=15./bpm;
    tick=int(time/tl);
    tt=mod(time,tl);
    bar=tick>>3;
    tick&=7;
    o+=getDrum(sq1[bar%sl1]); //drums
    o+=getPerc(sq2[bar%sl2]); //percussion
    o+=getNote(sq3[bar%sl3]); //bass
    o+=getNote(sq4[bar%sl4]); //melody1
    o+=getNote(sq5[bar%sl5]); //melody1 delay
    o+=getNote(sq6[bar%sl6]); //chord1 & melody2
    o+=getNote(sq7[bar%sl7]); //chord2 & melody2 delay
    o+=getNote(sq8[bar%sl8]); //chord3 & melody3
    o+=getNote(sq9[bar%sl9]); //chord4 & melody3 delay
    o+=getNote(sqA[bar%slA]); //bass2
    return o;
}

//----------------------------------------
// Master
vec2 mainSound( int samp, float time )
{
    vec2 o=vec2(0);
    float vol=1.;if(time>sec-fade){vol=(sec-min(time,sec))/fade;}
    time-=start*60./bpm;if(time<0.)return o;
    stereo=0.5;
    o+=sequencer(time);
    float d=delaywet,r=delaytime;
    for(int i=0;i<delayrepeat;i++){
        stereo+=0.3/float(delayrepeat);
        time-=delaytime;if(time<0.)continue;
        r+=delaytime;
        o+=sequencer(time)*d;
        d*=delayfb;
    }
    return amp(o,vec3(drive,pressure,vol));
}
