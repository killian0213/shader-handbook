vec4 c2v(int n){
    n=cp[(n+cpn)%cpn];
    return vec4(float((n>>8)&255)*.5,float((n>>24)&255)*.0625,float((n)&255)*-.5+52.,3.5-float((n>>16)&255)*pi/128.);
}

//GET TEXTURE COLOR ID
int ti(int x,int y){x&=31;y%=169;return ((th[y]>>(31-x))&1)*2+((tl[y]>>(31-x))&1); }

//GET MAP TILE ID
int mt(int mx,int my){mx%=56;my%=52;my=51-my;return (fm[(mx>>3)+my*7]>>(28-(mx&7)*4))&15;}

//SHADOW
float gs(ivec2 p,ivec2 q,int w){
    return ((q.x-p.x)*(q.x+w-p.x)>0)||((q.y-p.y)*(q.y+16-p.y)>0)?1.:floor(float(p.y-q.y)/4.)/8.+.5;
}

//GET GROUND PALETTE ID
int gnd(int x,int y, out float sv){
    int mx=((x+17920)%1792)>>5,my=((y+16640)%1664)>>5;
    int tx=((x+4000)&31)>>3,ty=((y+4000)&31)>>3;
    int cx=(x+4000)&7,cy=7-(y+4000)&7;
    int tile=mt(mx,my);
    int tb=(tile>>2)&3;
    ivec4 t=ivec4(tb*0x01010101);
    sv=1.;
    if(tb<2){
    //water
        //cape
        if(mt(mx+ 1,my+51)>7)t[0]=(t[0]&0xffffff00)|0x00000005;
        if(mt(mx+ 1,my+ 1)>7)t[3]=(t[3]&0xffffff00)|0x00000004;
        if(mt(mx+55,my+ 1)>7)t[3]=(t[3]&0x00ffffff)|0x07000000;
        if(mt(mx+55,my+51)>7)t[0]=(t[0]&0x00ffffff)|0x06000000;
        //beach
        int e;
        e=mt(mx,my+51);bool e0=((e>7)&&(e<13));
        e=mt(mx+ 1,my);bool e1=((e>7)&&(e<13));
        e=mt(mx,my+ 1);bool e2=((e>7)&&(e<13));
        e=mt(mx+55,my);bool e3=((e>7)&&(e<13));
        if(e0){t[0]=0x0a0a0a0a;}
        if(e1){        
            t[0]=(t[0]&0xffffff00)|0x00000009;t[1]=(t[1]&0xffffff00)|0x00000009;
            t[2]=(t[2]&0xffffff00)|0x00000009;t[3]=(t[3]&0xffffff00)|0x00000009;
        }
        if(e2){t[3]=0x08080808;}
        if(e3){
            t[0]=(t[0]&0x00ffffff)|0x0b000000;t[1]=(t[1]&0x00ffffff)|0x0b000000;
            t[2]=(t[2]&0x00ffffff)|0x0b000000;t[3]=(t[3]&0x00ffffff)|0x0b000000;
        }
        //bay
        if(e0&&e1){t[0]=(t[0]&0xffff0000)|0x00001a1b;t[1]=(t[1]&0xffffff00)|0x00000017;}
        if(e1&&e2){t[2]=(t[2]&0xffffff00)|0x00000013;t[3]=(t[3]&0xffff0000)|0x00000e0f;}
        if(e2&&e3){t[2]=(t[2]&0x00ffffff)|0x10000000;t[3]=(t[3]&0x0000ffff)|0x0c0d0000;}
        if(e3&&e0){t[0]=(t[0]&0x0000ffff)|0x18190000;t[1]=(t[1]&0x00ffffff)|0x14000000;}
    }else{
    //ground
        t=ivec4(0x02020202);
        if(tb==3){
        //bricks
            t[1]=0x02030302;t[2]=0x02030302;
            //road
            if(mt(mx,my+51)>11){t[0]=(t[0]&0xff0000ff)|0x00030300;}
            if(mt(mx+ 1,my)>11){t[1]=(t[1]&0xffffff00)|0x00000003;t[2]=(t[2]&0xffffff00)|0x00000003;}
            if(mt(mx,my+ 1)>11){t[3]=(t[3]&0xff0000ff)|0x00030300;}
            if(mt(mx+55,my)>11){t[1]=(t[1]&0x00ffffff)|0x03000000;t[2]=(t[2]&0x00ffffff)|0x03000000;}
        }
    }
    //shadow
    ivec2 p=ivec2(x&31,y&31);
    if(tile==9){
        sv=min(gs(p,ivec2(5,0),5),gs(p,ivec2(21,0),5));
        sv=min(gs(p,ivec2(13,16),5),sv);
    }else if(tile==10){
        sv=min(gs(p,ivec2(0,0),31),gs(p,ivec2(0,16),31));
    }else if(tile==11){
        sv=gs(p,ivec2(1,0),29);
    }
    //palette
    int chr=(t[ty]>>(24-tx*8))&255;
    int pb=chr==3?4:0;
    return ti(cx+(chr&3)*8,cy+(chr>>2)*8)+pb;
}

//COLLISION
ivec2 obj(vec3 p,vec3 oo,vec2 ob){
    vec3 p1=oo-p,p2=p1+vec3(ob,0);
    ivec2 r=ivec2(-1);
    if((p1.x*p2.x>0.)||(p1.y*p2.y>0.))return r;
    r.x=int(abs(p1.x)*32.);
    r.y=int(abs(p1.y)*32.);
    return r;
}

//WATER
float noise2d(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453123);}
float gl(vec3 p){
    p.xz-=floor(iTime*.1);
    p.y+=fract(iTime*.25);
    p=floor(p*32.);
    return noise2d(vec2(noise2d(p.xy),p.z));
}

//MAIN
void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
    vec4 c=vec4(1);
    //camera
    vec2 uv=(fragCoord-.5*iResolution.xy)/iResolution.y;uv.y=-uv.y;
    float bt=.5+iTime*BPM/240.;
    int cn=int(floor(bt))%cpn;
    vec4 cam=mix(c2v(cn),c2v(cn+1),fract(bt));
    vec3 ro=cam.xyz+.5,rd=normalize(vec3(uv,-sqrt(max(1.+dot(uv, uv)*(uv.y+.25)*.3,0.))));
    rd.yz*=rot(cam.w);

    //scenery
    vec3 p=vec3(0);
    int x,y,t=0,e=0,g=0,co=0;
    float d=1.-fract(ro.z),l=0.;//ray length
    ivec2 ip;
    vec3 oo;
    for(int i=ZERO;i<40;i++){
        l=abs(d/rd.z);d+=.50001;p=ro+rd*l;
        oo=floor(vec3(p.x,0,p.z));
        x=int(oo.x),y=int(oo.z);
        t=mt(x,y);
        if((t>8)&&((t&12)==8)){
            if((t&3)==2){
                //mountain1
                ip=obj(p,oo,vec2(1,.59));
                if(ip.y>-1){e=ti(ip.x,168-ip.y);co=4;}
            }else if((t&3)==1){
                //forest1
                ip=obj(p,oo,vec2(1,.937));
                if(ip.y>-1){e=ti(ip.x&15,149-ip.y)+ti(16+(ip.x&15),149-ip.y)*4;co=4;}
            }else{
                //building
                ip=obj(p,oo,vec2(1,1));
                if(ip.y>-1){
                    int v=x+y*56;
                    if((v==2665)||(v==2291)||(v==2319)||(v==1890)||(v==1468)||(v==984)){
                        e=ti(ip.x,119-ip.y);co=0;
                    }else{
                        e=ti(ip.x,87-ip.y);co=8;
                    }
                }
            }
        }
        if((e>0)||(p.y<0.))break;
        l=abs(d/rd.z);d+=.5;p=ro+rd*l;
        oo=floor(vec3(p.x,0,p.z));
        x=int(oo.x),y=int(oo.z);
        t=mt(x,y);
        if(t==8)continue;
        if((t&12)==8){
            if((t&3)==2){
                //mountain2
                oo.z-=.5;
                ip=obj(p,oo,vec2(1,.59));
                if(ip.y>-1){e=ti(ip.x,168-ip.y);co=4;}
            }else if((t&3)==1){
                //forest2
                oo.x+=.25;
                oo.z-=.5;
                ip=obj(p,oo,vec2(.5,.937));
                if(ip.y>-1){e=ti(ip.x&15,149-ip.y)+ti(16+(ip.x&15),149-ip.y)*4;co=4;}
            }
        }
        if((e>0)||(p.y<0.))break;
    }
    float dp,sv;
    l=abs(ro.y/rd.y);
    if(e>0){
        //objects
        e+=co;
        dp=length(p-ro)/FAR;
        c=clamp(vec4(tp[e].rgb,dp),0.,1.);
    }else if((rd.y<-.01)&&(l<60.)){
        //ground
        l=abs(ro.y/rd.y);
        p=ro+rd*l;
        x=int(p.x*32.);
        y=int(p.z*32.);
        dp=length(p-ro)/FAR;
        c=clamp(vec4(tp[gnd(x,y,sv)].rgb,dp),0.,1.);
        if(c.b>.8){
            c.rgb=c.g<.5?vec3(.2,.6+rd.y*.5,.8):c.rgb;
            c.rgb=mix(vec3(.25,.3,.25),c.rgb,clamp((rd.y*2.+1.5),.5,1.));
            c.rg*=gl(p)+.5;
        }
        c.rgb*=sv;
    }else{
        //sky
        dp=0.;
        c=vec4(.3,.7-rd.y*.5,.9,1);
    }
    //fog
    c.rgb=mix(c.rgb,vec3(.4,.6,.5),clamp(dp*2.-1.1,0.,1.));
    fragColor=c;
}