vec2 play( float t )
{
    int ZERO = int(min(t,0.0));
    
    vec2 y = vec2(0.0);

    int b = 0;
    for( int i=ZERO; i<kMusic.length(); i++)
    {
        // decode next key press/note
        int dsk = kMusic[i];
        int d = (dsk>>20)&0xfff; // time delta
        int s = (dsk>> 8)&0xfff; // sustain time
        int k = (dsk>> 0)&0x07f; // MIDI key/note
        b += d;
        
        // time
        const float tps = 940.0; // 960 in the original performance
        float bt = float(b)/tps;

        // randomize a bit key press times
        bt += 0.006*sin(float(i)*56124.0);

        // from this moment on, all key presses are
        // in the future, no need to parse any more
        if( bt>t ) break;
        
        // randomize key press force/velocity a bit
        float v = 0.85 + 0.15*sin(float(i)*6731.0);

        // evaluate sound for this key press, and add
        y += piano( float(k), t-bt, float(s)/tps, v );
    }

    return y;
}

vec2 mainSound( in int samp, float time )
{
    return 0.3*play( time );
}
