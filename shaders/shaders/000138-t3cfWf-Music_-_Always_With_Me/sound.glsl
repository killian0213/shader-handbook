// Sound (sound) — Music - Always With Me by iq
// https://www.shadertoy.com/view/t3cfWf

// Hm, I'm quite disappointed with this one.
// I tried encoding as many aspects of piano
// physics as I was able to learn about, but
// regardless it sounds like a xilophone and
// not like a piano. The lack of bridge+body
// resonance probably doesn't help. I cannot
// use delay lines or IIR filters (the whole
// point is to make the piano procedural, as
// a function of time only), but I could try
// simulating it with an extra loop over the
// song, likely at the risk of exploding the
// GLSL compiler...

const float kTau = 6.283185;

float fm( float fc, float fm, float im, float t )
{
    return sin(kTau*fc*t + im*sin(kTau*fm*t));
}

float note2freq( in float x )
{
	return 440.0*exp2((x-69.0)/12.0);
} 

vec2 piano( float k, float t, float s, float v )
{
    if( t>5.0 ) return vec2(0.0); // End after 5s

    // Pianos are NOT tuned to the equal temperament, they stretch
    // a bit such that the inharmonicty of each note overlaps with
    // the base of the next. I designed the stretch function below
    // by eye-balling some measurement graphs I've found around:
    float nd = k-66.0;
    float d = 0.00035*nd*nd*nd;

    // Base frequency for key k (equal temperament with
    // stetching accounted for in d, measured in cents)
    float f = note2freq(k+d/100.0);

    // The inharmonicity coefficient, from "Normal Vibrations of a
    // Stiff Piano String", Harvey Fletcher (1964). It detunes the
    // harmonics. Without it, all of this would just sounds like a
    // bell rather than a piano. Cuve matches following "Rigaud et
    // al.": [-0.05,-0.10] [-6.5,-7.5] [0.08,0.12] [-14,-15]
    float B = 0.0002 + exp(-0.07*k-6.5)+exp(0.09*k-15.0);

    // Add all harmonics
    vec2 y = vec2(0.0,0.0);
    for( int n=1; n<25; n++ )
    {
        float n1 = float(n);
        float n2 = float(n*n);

        // Frequency of harmonic (with Fletcher's distortion B)
        float fn = n1*f*sqrt(1.0+B*n2);
        
        // Let's not alias
        if( fn>44100.0/2.0 ) break; 

        // Harmonics amplitude vary in many ways
        float am = 1.0;
        // ... as the hammer hits at 1/7 the string length, it
        //     zeroes out every 7th harmonics. Here I consider
        //     that for high pitch keys, the hammers hit their
        //     strings as low as 1/20th of their length.
        float strike = 1.0/7.0 - 0.04/(1.0+exp( 0.15*(k-40.0))) 
                               - 0.08/(1.0+exp(-0.15*(k-90.0)));
        am *= abs(sin(n1*0.5*kTau*strike));
        // ... also, higher harmonics are weaker, usually
        //     inversely proportional to the 4th power of
        //     the harmonic index n1. But here I let most
        //     harmonics survive for a little bit, before
        //     turning them off, to simulate the harmonic
        //     mess that happens when the hammer hits the
        //     string.
        float re = 1.8 + 1.2*clamp( (60.0-k)/(60.0-36.0), 0.0, 1.0 );
        re += 0.8*exp2(-10.0*t );
        am /= pow(n1, 4.0-re*v);
        
        // Dampen strings, higher frequencies quicker, ...
        // (formula inspired by Chaigne and Askenfelt)
        float ka = 0.05*sqrt(f);
        float kb = (2.0+0.2*0.01*f)*1e-6;
        vec3 at = exp( -(ka+kb*fn*fn)*
        //   ...both from moment we press the key (string is free)...
                        0.14*(vec3(2.0,1.9,2.1)*t +
        //   ...and the moment we release the key/string
                              8.0*max(t-s,0.0)) );
        
        // Simulate 2 or 3 strings per note
        //   ... including some short lived FM for extra richness
        //       in the first moments after the hammer hit.
        float mi = 0.5*(0.05+1.0*clamp((117.0-k)/24.0,0.0,1.0))*exp2(-25.0*t);
        ///  ... and some detuning between strings
        float de1 = 1.0004 + 0.0002*v; // about 1 cent
        float de2 = 1.0003 + 0.0003*v; // about 1 cent
        float de3 = 1.0007 + 0.0004*v; // about 2 cent
                   y += vec2(0.8,0.2)*v*am*fm(fn/de1, 2.0*fn/de1, mi, t+0.11*n1)*at.x;
                   y += vec2(0.2,0.8)*v*am*fm(fn*de2, 2.0*fn*de2, mi, t+0.07*n1)*at.y; 
        if(k>53.0) y += vec2(0.3,0.3)*v*am*fm(fn*de3, 2.0*fn*de3, mi, t+0.17*n1)*at.z;
    }
 
    // In low notes the string also vibrates longitudinally, which
    // creates a high-frequency that isn't a harmonic of the base
    y += 0.04*v*clamp((62.0-k)/12.0,0.0,1.0)*sin(kTau*f*16.1*t)*exp(-20.0*t);

    // More hammer kick
    y += 0.4*v*exp2(-144.0*t)*vec2(sin(kTau*f/2.01*t),cos(kTau*f/1.99*t));

    return y*min(t/0.0002,1.0);
}

